{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tapty",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/tg/*", "/item/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapty",
      "database_id": "dd37e776-48bd-4faf-85f6-1909af44359d"
    }
  ],
  // Когда включите R2: создайте бакет tapty-photos и уберите комментарии ниже.
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "tapty-photos" }],
  // Нейросеть для кнопки «Заполнить по фото».
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
